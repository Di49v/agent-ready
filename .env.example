# --- Environment & Sandbox Lock (Rule B3.12: Never switch to live) ---
APP_ENV=development
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com

# --- PayPal Sandbox Credentials ---
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id_here
PAYPAL_SANDBOX_BUYER_PAYER_ID=your_sandbox_buyer_payer_id_for_auth_assertion
PAYPAL_PRE_SEEDED_DISPUTE_ID=PP-D-XXXXXXX

# --- Gemini API Key Sharding Pool (Comma-separated for round-robin rotation) ---
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2,your_gemini_key_3

# --- Hackathon Sponsor APIs ---
CHANNEL3_API_KEY=your_channel3_api_key_here
APIMATIC_API_KEY=your_apimatic_key_here

# --- Database & Internal Probe Security ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentready_lab
LAB_PROBE_HMAC_SECRET=generate_a_32_byte_hex_secret_for_probe_ledger_signing
CART_RECEIPT_HMAC_SECRET=generate_a_32_byte_hex_secret_for_cart_intent_mandate
LAB_API_KEY=judge_demo_public_key_2026