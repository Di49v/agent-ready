# --- Environment & Sandbox Lock (Never switch to live) ---
APP_ENV=development
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
REDACT_SENSITIVE_LOGS=true
ENABLE_JUDGE_ARENA=true

# --- Concurrency & Reconciler Timing Windows ---
MAX_CONCURRENT_BUYERS=5
WEBHOOK_SETTLE_WINDOW_SEC=5
RULE3_SLA_SECONDS=8

# --- PayPal Sandbox Credentials (US Business & US Buyer Accounts) ---
PAYPAL_CLIENT_ID=your_us_business_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_us_business_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id
PAYPAL_SANDBOX_BUYER_PAYER_ID=your_us_personal_buyer_13_char_payer_id
PAYPAL_PRE_SEEDED_DISPUTE_ID=PP-D-XXXXXXX

# --- Sandbox Test Card (YYYY-MM expiry format; redacted from all logs/DB) ---
PAYPAL_TEST_CARD_NUMBER=4032033950884192
PAYPAL_TEST_CARD_EXPIRY=2028-02
PAYPAL_TEST_CARD_CVV=957

# --- Gemini 3.8 Flash API Key Sharding Pool ---
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2,your_gemini_key_3

# --- Hackathon Sponsor APIs ---
CHANNEL3_API_KEY=your_channel3_api_key
CHANNEL3_CACHE_TTL_SEC=300
APIMATIC_API_KEY=your_apimatic_key

# --- Supabase Database & New API Keys (sb_publishable_ / sb_secret_) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your_db_password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- Internal HMAC Signers & Abuse Guard ---
LAB_PROBE_HMAC_SECRET=replace_with_32_byte_hex_secret_for_probe_ledger
CART_RECEIPT_HMAC_SECRET=replace_with_32_byte_hex_secret_for_cart_receipts
LAB_API_KEY=judge_demo_public_key_2026
RATE_LIMIT_RUNS_PER_10_MIN=10